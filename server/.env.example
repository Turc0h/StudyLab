PORT=3001
FRONTEND_URL=http://localhost:5173

# Credenciales de un OAuth Client (tipo "Web application") creado en
# https://console.cloud.google.com/apis/credentials, con la Calendar API habilitada.
# El Authorized redirect URI ahí tiene que ser EXACTAMENTE el mismo valor que
# GOOGLE_REDIRECT_URI acá abajo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
